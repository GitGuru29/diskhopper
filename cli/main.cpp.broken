#include <algorithm>
#include <chrono>
#include <cstdio>
#include <cstdlib>
#include <filesystem>
#include <map>
#include <string>
#include <vector>

#include "diskhopper/classifier/Classifier.hpp"
#include "diskhopper/cleaner/Cleaner.hpp"
